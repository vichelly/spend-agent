# Copy to .env (gitignored). Fill ONE provider; never commit the real key.
# Pick a provider (default: anthropic):  anthropic | gemini | zai | deepseek | groq | openrouter | openai-compat
FINOPS_PROVIDER=gemini

# Free tiers (no card): Google AI Studio -> GEMINI_API_KEY, Z.ai -> ZAI_API_KEY, Groq -> GROQ_API_KEY
GEMINI_API_KEY=
ZAI_API_KEY=
GROQ_API_KEY=
# Very cheap: DeepSeek (about $0.14-0.28 per million tokens)
DEEPSEEK_API_KEY=
# Claude
ANTHROPIC_API_KEY=

# Optional: override the provider's default model id (ids change; check the provider docs)
# FINOPS_MODEL=gemini-2.5-flash
# Custom OpenAI-compatible server (Ollama, vLLM, ...): FINOPS_PROVIDER=openai-compat
# FINOPS_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
